            <chunk name="Object" index="11">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from honeybee.room import Room

rows = []

for hb_room in rooms or []:
    spaces = hb_room.properties.ph.spaces
    restored_room = Room.from_dict(hb_room.to_dict())
    restored_spaces = restored_room.properties.ph.spaces

    rows.append("ROOM: {}".format(hb_room.display_name))
    rows.append("space_count: {}".format(len(spaces)))
    rows.append(
        "roundtrip_space_count: {}".format(len(restored_spaces))
    )

    for ph_space in spaces:
        rows.append("space_name: {}".format(ph_space.name))
        rows.append("host_is_output_room: {}".format(
            ph_space.host is hb_room
        ))
        rows.append("volume_count: {}".format(
            len(ph_space.volumes)
        ))
        rows.append("floor_segment_count: {}".format(
            len(ph_space.floor_segments)
        ))
        rows.append("floor_area: {}".format(
            ph_space.floor_area
        ))
        rows.append("weighted_floor_area: {}".format(
            ph_space.weighted_floor_area
        ))
        rows.append("net_volume: {}".format(
            ph_space.net_volume
        ))
        rows.append("volume_heights: {}".format(
            [v.avg_ceiling_height for v in ph_space.volumes]
        ))

    for restored_space in restored_spaces:
        rows.append("roundtrip_host_ok: {}".format(
            restored_space.host is restored_room
        ))

a = "\n".join(rows)</item>
